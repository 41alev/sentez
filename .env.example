# --- Sunucu / Server ---
PORT=3000
NODE_ENV=production
LOG_LEVEL=info

# --- Güvenlik / Security ---
# ÜRETİMDE MUTLAKA DEĞİŞTİRİN. Öneri: openssl rand -hex 48
JWT_SECRET=CHANGE-ME-uzun-rastgele-bir-deger
TOKEN_TTL_HOURS=12
FORCE_HTTPS=0

# Virgülle ayrılmış izinli origin listesi. Boş bırakılırsa tüm origin'lere izin verilir (sadece geliştirme için).
CORS_ORIGINS=

# --- Hız sınırlama / Rate limiting ---
# 15 dakikalık pencerede izin verilen BAŞARISIZ giriş denemesi (başarılılar sayılmaz)
LOGIN_RATE_LIMIT=10
API_RATE_LIMIT=300

# --- Veri / Data ---
DATA_DIR=./data
UPLOAD_DIR=

# Yalnızca güvenilir ters vekilin IP/CIDR aralığı; doğrudan bağlantıda boş bırakın.
# Docker Compose içindeki nginx yapılandırması uniquelocal değerini ayarlar.
TRUST_PROXY=

# --- Yedekleme / Backup ---
BACKUP_INTERVAL_HOURS=24
BACKUP_KEEP=14
BACKUP_DIR=
# Yerel yedek sunucuyla AYNI diskte durur — disk arızası/yangın/hırsızlıkta
# yedek de gider. Bu komut her başarılı yerel yedekten sonra çalışır; {file}
# tam paket dizininin yoluyla, {name} paket adıyla değiştirilir. Boşsa off-site
# senkronizasyon yapılmaz (varsayılan). Örnekler için docs/KURULUM.md.
# Örnek (rclone → S3 uyumlu depolama):
#   BACKUP_OFFSITE_CMD=rclone copy "{file}" remote:depo-takip-yedek/{name}/
# Windows robocopy çıkış kodları için özel bir .ps1/.bat sarmalayıcı kullanın.
BACKUP_OFFSITE_CMD=

# --- Arka plan işleri / Background jobs (1 = kapat) ---
DISABLE_JOBS=0

# --- E-posta bildirimleri (opsiyonel) / Email alerts (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
SMTP_FROM=depo-takip@example.com

# --- Lisanslama / Licensing (opsiyonel) ---
# Boş bırakılırsa (varsayılan) hiçbir lisans kontrolü yapılmaz — bugünkü ömür
# boyu lisans satış modeli budur. Aylık/yıllık lisansa geçilecek bir müşteri
# için: `npm run license:generate -- --licensee "Firma Adı" --expires YYYY-MM-DD`
# ile bir lisans dosyası üretin, sunucuya kopyalayın ve yolunu buraya yazın.
# Sunucu, dosya geçersiz veya süresi dolmuşsa kasıtlı olarak açılmaz (bkz.
# server/lib/license.js, docs/KURULUM.md).
LICENSE_FILE=
