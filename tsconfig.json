{
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "checkJs": true,
    "allowJs": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "server/**/*.js",
    "server/types/**/*.d.ts",
    "public/js/**/*.js",
    "test/**/*.js",
    "frontend-react/**/*.jsx",
    "frontend-react/**/*.js"
  ],
  "exclude": [
    "node_modules",
    "data"
  ]
}
